HOST=127.0.0.1
PORT=4000
CORS_ORIGIN=http://localhost:3000
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-service-role-key
SUPABASE_PASSWORD=replace-with-your-db-password
SUPABASE_REF=your-project-ref
RESEND_API_KEY=replace-with-your-resend-api-key
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_MS=900000

# Comma-separated list of admin notification recipients (diagnosis intake +
# case-file access requests both send here).
ADMIN_EMAILS=teslimshehu17@gmail.com,teslimnysc17@gmail.com

# Required. Shared secret for the internal /admin/send-case-file tool and
# the /api/admin/send-case-file endpoint it calls. Generate with:
#   openssl rand -hex 32
# Treat this like a password -- do not commit the real value.
ADMIN_API_TOKEN=replace-with-a-long-random-secret

# Optional. Absolute path to the folder holding ats-funded.pdf,
# traderlab.pdf and unified-proof.pdf. Defaults to ./private/case-files
# relative to wherever the server process is started.
# CASE_FILE_DIR=/absolute/path/to/private/case-files
